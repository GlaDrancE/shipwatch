{
  "openapi": "3.0.3",
  "info": {
    "title": "ParcelPost API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Shipment": {
        "type": "object",
        "properties": {
          "trackingId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_transit",
              "delivered"
            ]
          },
          "eta": {
            "type": "string",
            "format": "date"
          },
          "recipient": {
            "type": "string"
          },
          "destination": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "trackingId",
          "status"
        ]
      },
      "NewShipment": {
        "type": "object",
        "properties": {
          "recipient": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        },
        "required": [
          "recipient",
          "city"
        ]
      }
    }
  },
  "paths": {
    "/shipments": {
      "get": {
        "operationId": "listShipments",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "recent shipments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "trackingId": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "in_transit",
                          "delivered"
                        ]
                      },
                      "eta": {
                        "type": "string",
                        "format": "date"
                      },
                      "recipient": {
                        "type": "string"
                      },
                      "destination": {
                        "type": "object",
                        "properties": {
                          "city": {
                            "type": "string"
                          },
                          "lat": {
                            "type": "number"
                          },
                          "lon": {
                            "type": "number"
                          }
                        }
                      },
                      "events": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "at": {
                              "type": "string"
                            },
                            "note": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    },
                    "required": [
                      "trackingId",
                      "status"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createShipment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recipient": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  }
                },
                "required": [
                  "recipient",
                  "city"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "trackingId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "in_transit",
                        "delivered"
                      ]
                    },
                    "eta": {
                      "type": "string",
                      "format": "date"
                    },
                    "recipient": {
                      "type": "string"
                    },
                    "destination": {
                      "type": "object",
                      "properties": {
                        "city": {
                          "type": "string"
                        },
                        "lat": {
                          "type": "number"
                        },
                        "lon": {
                          "type": "number"
                        }
                      }
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "at": {
                            "type": "string"
                          },
                          "note": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "trackingId",
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/shipments/{trackingId}": {
      "get": {
        "operationId": "getShipment",
        "parameters": [
          {
            "name": "trackingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a shipment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "trackingId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "in_transit",
                        "delivered"
                      ]
                    },
                    "eta": {
                      "type": "string",
                      "format": "date"
                    },
                    "recipient": {
                      "type": "string"
                    },
                    "destination": {
                      "type": "object",
                      "properties": {
                        "city": {
                          "type": "string"
                        },
                        "lat": {
                          "type": "number"
                        },
                        "lon": {
                          "type": "number"
                        }
                      }
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "at": {
                            "type": "string"
                          },
                          "note": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "trackingId",
                    "status"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      }
    }
  }
}
